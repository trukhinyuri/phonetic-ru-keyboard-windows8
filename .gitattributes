* text=auto

# MSKLC only opens UTF-16LE files with a BOM. Git stores them as UTF-8 so
# that diffs and GitHub's file view work, and converts them on checkout.
*.klc   text working-tree-encoding=UTF-16LE-BOM eol=crlf diff

# Windows scripts.
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf

*.c     text eol=lf
*.h     text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.svg   text eol=lf

*.dll   binary
*.png   binary
